rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Fetch the user's role from their profile document
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : -1;
    }

    // Role checks
    function isAdmin() {
      return isSignedIn() && (getUserRole() == 3 || getUserRole() == 'admin' || getUserRole() == 'Admin');
    }

    function isDriver() {
      return isSignedIn() && (getUserRole() == 2 || getUserRole() == 'driver' || getUserRole() == 'Driver');
    }

    function isMerchant() {
      return isSignedIn() && (getUserRole() == 1 || getUserRole() == 'merchant' || getUserRole() == 'Merchant');
    }

    // Check if the document belongs to the authenticated user
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      // Everyone who is signed in can read user documents
      allow read: if isSignedIn();
      
      // Users can create their own account.
      allow create: if isOwner(userId);
      
      // Users can update their own data. Role/balance checking is relaxed temporarily to fix login loop.
      allow update: if isOwner(userId) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // 2. Products Collection
    match /products/{productId} {
      // Anyone can read products. 
      // هام جداً: يرجى تفعيل Firebase App Check لحماية هذه القاعدة من الاستهلاك العشوائي بواسطة البوتات.
      allow read: if true;
      
      // Only Merchants can create products, and the product must be assigned to them
      allow create: if (isMerchant() && request.resource.data.merchantId == request.auth.uid) || isAdmin();
      
      // Only the merchant who owns the product (or Admin) can update/delete it
      allow update, delete: if isAdmin() || (isMerchant() && resource.data.merchantId == request.auth.uid);
    }

    // 3. Categories Collection
    match /categories/{categoryId} {
      // Anyone can read categories
      allow read: if true;
      // Only Admin can add/edit categories
      allow write: if isAdmin();
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      // Customers can read their own orders. Merchants can read their store's orders.
      // Drivers can read ALL orders (needed for the "Available Orders / Radar" feature to see unassigned orders).
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.merchantId == request.auth.uid || 
        isDriver() ||
        isAdmin()
      );

      // Only Customers can create an order, and they must set themselves as the customerId.
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;

      // Update rules:
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.merchantId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        (isDriver() && (resource.data.driverId == null || resource.data.driverId == "") && request.resource.data.driverId == request.auth.uid) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // 5. Transactions / Wallet
    match /transactions/{transactionId} {
      // Users can only read their own transactions
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Users can create a transaction log (e.g., pending recharge)
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only Admins can approve/update/delete transactions
      allow update, delete: if isAdmin();
    }

    // 6. Support Chats
    match /support_chats/{userId} {
      // Users can read/write their own support chats. Admin can read/write all.
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Allow operations on messages inside the chat
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 7. System Settings
    match /system_settings/{docId} {
      // Everyone can read global settings (fees, currency, app version, etc.)
      allow read: if true;
      // Only admin can change settings
      allow write: if isAdmin();
    }
  }
}
